# Bender server configuration.
#
# Copy to apps/server/.env and fill in. Never commit the filled-in file.

# ---------------------------------------------------------------------------
# Azure OpenAI
# ---------------------------------------------------------------------------

# Resource endpoint, no path and no trailing slash.
AZURE_OPENAI_ENDPOINT=https://michaeljo-playground.openai.azure.com

# The DEPLOYMENT name from your Azure resource -- not a model name.
# Passing a model name here produces "404 DeploymentNotFound", which reads like
# an auth problem but is not one.
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-sol

AZURE_OPENAI_API_VERSION=2025-04-01-preview

# --- Authentication ---------------------------------------------------------
#
# Bender supports two modes and defaults to Entra ID.
#
#   entra    (default) Uses DefaultAzureCredential: `az login` locally, or a
#            managed identity when deployed. The signed-in identity needs the
#            "Cognitive Services OpenAI User" role on the resource.
#
#   api-key  Uses AZURE_OPENAI_API_KEY. Selected automatically if a key is set.
#
# Worth knowing before you debug this: key authentication can be switched off
# at the resource level, and when it is, every key request fails with
# 403 AuthenticationTypeDisabled regardless of whether the key is valid. That is
# the case on the michaeljo-playground resource this project was built against,
# which is why Entra ID is the default rather than the fallback.
#
# Leave AZURE_OPENAI_AUTH_MODE unset to let Bender choose.
# AZURE_OPENAI_AUTH_MODE=entra

# Only needed for api-key mode. Leave empty to use Entra ID.
AZURE_OPENAI_API_KEY=

# Token scope for Entra ID. The default suits public Azure.
# AZURE_OPENAI_SCOPE=https://cognitiveservices.azure.com/.default

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

PORT=8787
HOST=127.0.0.1

# Comma-separated browser origins allowed to call the API.
# Leave empty during local development to allow any origin.
# In production set this to the GitHub Pages origin, e.g.
# ALLOWED_ORIGINS=https://woohyun7878.github.io
ALLOWED_ORIGINS=

# Largest accepted .hlx upload, in bytes. Real presets are tens of KB.
MAX_PRESET_BYTES=2097152

# How long an idle session is kept, in milliseconds.
SESSION_TTL_MS=3600000

MAX_SESSIONS=200

# Ceiling on model/tool round trips per user message.
MAX_TOOL_ITERATIONS=12

# debug | info | warn | error
LOG_LEVEL=info
