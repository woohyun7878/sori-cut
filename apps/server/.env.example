# Bender server configuration.
#
# Copy to apps/server/.env and fill in. Loaded automatically at startup.
# apps/server/.env.local overrides apps/server/.env; both are gitignored.
# Real environment variables beat both, so a deployed host is unaffected.

# ---------------------------------------------------------------------------
# Azure OpenAI
# ---------------------------------------------------------------------------

# Resource endpoint. The full Responses URL from the portal works too -- the
# /openai/... path and api-version are parsed out of it.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com

# The DEPLOYMENT name from your Azure resource -- not a model name.
# Passing a model name here produces "404 DeploymentNotFound", which reads like
# an auth problem but is not one.
#
# Develop against a cheap deployment. Production runs a larger, paid one and
# every local turn spends real budget if you point at it.
AZURE_OPENAI_DEPLOYMENT=<your-deployment>

AZURE_OPENAI_API_VERSION=2025-04-01-preview

# --- Authentication ---------------------------------------------------------
#
#   entra    (default) DefaultAzureCredential: `az login` locally, or a managed
#            identity when deployed. The identity needs the
#            "Cognitive Services OpenAI User" role on the resource.
#
#   api-key  Uses AZURE_OPENAI_API_KEY. Selected automatically when a key is set.
#
# A resource can have key auth switched off, and when it is, every key request
# returns 403 AuthenticationTypeDisabled however valid the key is. The dev
# resource is configured that way, which is why Entra ID is the default.
#
# Leave AZURE_OPENAI_AUTH_MODE unset to let Bender choose.
# AZURE_OPENAI_AUTH_MODE=entra

# Only needed for api-key mode. Leave empty to use Entra ID.
AZURE_OPENAI_API_KEY=

# Token scope for Entra ID. The default suits public Azure.
# AZURE_OPENAI_SCOPE=https://cognitiveservices.azure.com/.default

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

PORT=8787
HOST=127.0.0.1

# Comma-separated browser origins allowed to call the API.
# Leave empty during local development to allow any origin.
# In production this is the Pages origin alone.
ALLOWED_ORIGINS=

# Largest accepted .hlx upload, in bytes. Real presets are tens of KB.
MAX_PRESET_BYTES=2097152

# How long an idle session is kept, in milliseconds.
SESSION_TTL_MS=3600000

MAX_SESSIONS=200

# Ceiling on model/tool round trips per user message.
MAX_TOOL_ITERATIONS=12

# debug | info | warn | error
LOG_LEVEL=info
