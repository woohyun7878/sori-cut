{
  "name": "@bender/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bender API — Azure OpenAI orchestration and constrained Helix preset editing",
  "main": "dist/server.mjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "start:dist": "node dist/server.mjs",
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@azure/identity": "^4.5.0",
    "@bender/helix": "workspace:*",
    "@bender/tone-tools": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "fastify": "^5.2.0",
    "openai": "^4.77.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3",
    "vitest": "^2.1.9"
  }
}
