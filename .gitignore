node_modules
dist
.turbo
*.local
.env
.env.*
!.env.example
.DS_Store
*.tsbuildinfo

# pnpm is the package manager for this workspace (see packageManager in
# package.json) and CI installs with --frozen-lockfile. A stray npm or yarn
# lockfile silently diverges from pnpm-lock.yaml and misleads anyone who
# reaches for npm install out of habit.
package-lock.json
yarn.lock

# Preset files are private by default: someone else's presets, or your own
# scratch corpus for testing, should not land in a public repository.
presets/user/**/*.hlx
presets/user/**/*.hls
presets/user/**/*.hlb
presets/user/**/*.hxb
presets/user/**/*.json

# Templates and the owned corpus are the deliberate exceptions. Templates are
# the starter tones the app offers to users who arrive without a preset, so
# they have to ship. The corpus is the owned preset collection we test and
# evaluate against, so it has to be shared. Only add presets we own to either.
# Everything dropped into fixtures/ stays private.
!presets/user/templates/*.hlx
!presets/user/templates/*.json
!presets/user/corpus/*.hlx
!presets/user/corpus/*.json

# Evaluation output is a record of a local run, not a source artifact.
evals/results/**
!evals/results/.gitkeep
